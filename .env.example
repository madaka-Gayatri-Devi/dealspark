# Flask Environment Settings
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Authorized Single Administrator Account
ADMIN_EMAIL=nagarajuchaintala2002@gmail.com
ADMIN_INITIAL_PASSWORD=YourSecureInitialPasswordHere

# MySQL Database Configuration
# Direct URI format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://dealspark_user:dealspark_password@localhost:3306/dealspark

# Alternative individual DB params (used if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dealspark
DB_USER=root
DB_PASSWORD=

# Fallback to SQLite if MySQL is unavailable in local dev (true/false)
DB_ALLOW_SQLITE_FALLBACK=true

# Application Brand Settings
APP_NAME=DealSpark
APP_URL=http://127.0.0.1:5000

# Affiliate Tracking Security
ALLOWED_REDIRECT_DOMAINS=amazon.in,amzn.to,flipkart.com,fkrt.it,myntra.com,ajio.com,croma.com,reliancedigital.in,tatacliq.com
