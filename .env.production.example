# ====================================================================
# DealSpark Production Environment Configuration Template
# COPY this file to .env on your production server and fill in real values.
# NEVER commit or publicly expose the actual .env file.
# ====================================================================

# 1. Flask Production Environment
FLASK_APP=wsgi.py
FLASK_ENV=production

# 2. Production Secret Key
# Generate a cryptographically secure random key using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-64-character-cryptographically-secure-random-token

# 3. Dedicated Administrator Account
# Only this email address will be granted administrative access to /admin
ADMIN_EMAIL=nagarajuchaintala2002@gmail.com
ADMIN_INITIAL_PASSWORD=replace-with-a-strong-password-min-8-chars-letters-digits

# 4. Production MySQL Database Configuration
# Option A (Recommended): Direct connection URI
# Example: mysql+pymysql://dealspark_admin:SuperSecret123@localhost:3306/dealspark_db?charset=utf8mb4
DATABASE_URL=mysql+pymysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/<DB_NAME>?charset=utf8mb4

# Option B: Individual connection parameters (used if DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=<DB_NAME>
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>

# In production, strict MySQL is required. NEVER permit SQLite fallback:
DB_ALLOW_SQLITE_FALLBACK=false

# 5. Domain and Brand Configuration
APP_NAME=DealSpark
APP_URL=https://yourdomain.com

# 6. Security: Outbound Affiliate Domain Whitelist (comma-separated, no spaces)
ALLOWED_REDIRECT_DOMAINS=amazon.in,amzn.to,flipkart.com,fkrt.it,myntra.com,ajio.com,croma.com,reliancedigital.in,tatacliq.com

# 7. Optional Official Affiliate API Credentials
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=dealspark0e-21
AMAZON_REGION=eu-west-1

FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
